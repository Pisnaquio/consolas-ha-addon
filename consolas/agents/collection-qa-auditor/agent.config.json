{
  "name": "collection-qa-auditor",
  "version": "1.0.0",
  "mode": "audit-only",
  "project_root": ".",
  "output_file": "QA_REPORT.md",
  "stages": [
    {
      "id": "stage1",
      "name": "QA funcional y navegación",
      "input_file": "agents/collection-qa-auditor/runs/latest/stage1_functional.jsonl"
    },
    {
      "id": "stage2",
      "name": "Auditoría de datos y contenido",
      "input_file": "agents/collection-qa-auditor/runs/latest/stage2_data.jsonl"
    },
    {
      "id": "stage3",
      "name": "Auditoría visual, UX e imágenes",
      "input_file": "agents/collection-qa-auditor/runs/latest/stage3_visual.jsonl"
    }
  ],
  "consolidator": {
    "type": "python",
    "script": "agents/collection-qa-auditor/scripts/consolidate_findings.py",
    "args": [
      "--input-dir",
      "agents/collection-qa-auditor/runs/latest",
      "--output",
      "QA_REPORT.md"
    ]
  },
  "rules": {
    "auto_fix": false,
    "edit_project_files": false,
    "require_evidence": true
  }
}
