# Copiar a `agents/auction-watch/notification.env` para activar mail.
# Los valores tambien se pueden pasar como variables de entorno.

# macOS notification mode:
# always | matches | failure | matches_or_failure | disabled
AUCTION_WATCH_MACOS_NOTIFY=always
AUCTION_WATCH_MACOS_SUBTITLE=Bavastro + Castells

# email notification mode:
# always | matches | failure | matches_or_failure | disabled
AUCTION_WATCH_EMAIL_MODE=matches_or_failure
AUCTION_WATCH_EMAIL_METHOD=mailapp
AUCTION_WATCH_EMAIL_SUBJECT_PREFIX=[Auction Watch]

# Publicacion:
# - ha-required: el snapshot debe recibir ACK y verificarse antes del mail.
# - local-only: solo actualiza web/runtime/auction-watch.json, sin enlaces de accion.
AUCTION_WATCH_PUBLICATION_MODE=ha-required

# URL LAN/HTTPS de la app. Habilita enlaces de descarte en el mail y permite
# sincronizar las decisiones antes de cada corrida. No publicar este puerto en
# Internet; para acceso remoto usar VPN o un proxy autenticado.
AUCTION_WATCH_APP_BASE_URL=http://homeassistant.local:8788
# Opcional: usar un endpoint distinto al derivado de APP_BASE_URL.
# AUCTION_WATCH_DISMISSALS_URL=http://homeassistant.local:8788/api/auction-watch/dismissals
# El runner publica el snapshot en HA antes de enviar el mail. Si falla esta
# publicación, se suprime el mail con oportunidades para no enviar enlaces que
# todavía no existen en la página.
# AUCTION_WATCH_SNAPSHOT_URL=http://homeassistant.local:8788/api/auction-watch/snapshot
# Opcional: endpoint GET canonico si no deriva de APP_BASE_URL.
# AUCTION_WATCH_CANONICAL_SNAPSHOT_URL=http://homeassistant.local:8788/api/auction-watch

# Mail.app / destinatarios
# Sirve para la version simple. El boletin HTML real sale por `sendmail` o `smtp`.
AUCTION_WATCH_EMAIL_TO=tu_mail@example.com

# Alternativa: sendmail local
# Envia multipart con HTML, pero necesita que Postfix/sendmail salga realmente a internet.
# AUCTION_WATCH_EMAIL_METHOD=sendmail

# Alternativa: SMTP explicito
# Es la opcion recomendada para un boletin HTML real sin Mail.app.
# AUCTION_WATCH_EMAIL_METHOD=smtp
AUCTION_WATCH_SMTP_HOST=smtp.example.com
AUCTION_WATCH_SMTP_PORT=587
AUCTION_WATCH_SMTP_STARTTLS=true
AUCTION_WATCH_SMTP_USERNAME=tu_usuario
AUCTION_WATCH_SMTP_PASSWORD=tu_password_o_app_password

# envelope SMTP
AUCTION_WATCH_EMAIL_FROM=alertas@example.com
