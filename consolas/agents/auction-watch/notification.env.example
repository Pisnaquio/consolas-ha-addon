# Configuración de desarrollo local. En producción, Home Assistant inyecta
# estas variables desde las opciones privadas del add-on: no crear este archivo
# ni guardar secretos en el repositorio.

# El runtime canónico no usa notificaciones de macOS ni Mail.app.
AUCTION_WATCH_MACOS_NOTIFY=disabled
AUCTION_WATCH_EMAIL_MODE=matches_or_failure
AUCTION_WATCH_EMAIL_METHOD=smtp
AUCTION_WATCH_EMAIL_SUBJECT_PREFIX=[Auction Watch]

# Dentro del add-on la API es same-origin. run.sh define este valor.
AUCTION_WATCH_APP_BASE_URL=http://127.0.0.1:8788
AUCTION_WATCH_PUBLICATION_MODE=ha-required

# Valores de ejemplo exclusivamente para desarrollo local.
AUCTION_WATCH_EMAIL_TO=tu_mail@example.com
AUCTION_WATCH_SMTP_HOST=smtp.example.com
AUCTION_WATCH_SMTP_PORT=587
AUCTION_WATCH_SMTP_STARTTLS=true
AUCTION_WATCH_SMTP_USERNAME=tu_usuario
AUCTION_WATCH_SMTP_PASSWORD=tu_password_o_app_password
AUCTION_WATCH_EMAIL_FROM=alertas@example.com
